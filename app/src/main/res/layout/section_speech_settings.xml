<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/speech_engine_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/speech_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/speech_switch" />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/speech_auto_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/speech_auto_switch" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/speech_speed_label"
            android:textColor="@color/ink"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/speech_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
    <SeekBar
        android:id="@+id/speech_speed_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="150"
        android:minHeight="44dp"
        android:contentDescription="@string/speech_speed_label" />
    <TextView
        android:id="@+id/speech_voice_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/ink"
        android:textSize="16sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/speech_voice_pick"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/speech_voice_pick" />
    <TextView
        android:id="@+id/speech_voice_deletion_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/speech_voice_preview"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:minHeight="48dp"
        android:text="@string/speech_voice_preview" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/speech_voice_actions_toggle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/settings_manage_voice" />
    <LinearLayout
        android:id="@+id/speech_voice_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/speech_voice_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_voice_create"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/speech_voice_create" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_voice_import"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/speech_voice_import" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_voice_manage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/speech_voice_manage" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/speech_service_options_toggle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/settings_speech_options" />
    <LinearLayout
        android:id="@+id/speech_service_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/speech_cloud_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_cloud_edit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/speech_cloud_edit" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_offline_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/speech_offline_toggle" />
        <LinearLayout
            android:id="@+id/speech_offline_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/speech_local_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speech_local_download"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/speech_local_download" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speech_local_delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/speech_local_delete"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speech_cloud_retry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/speech_cloud_retry"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/speech_cache_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_cache_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/speech_cache_clear" />
    </LinearLayout>
</LinearLayout>
