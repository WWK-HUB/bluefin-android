<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Bluefin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainerLow">@color/ice</item>
        <item name="colorSurfaceContainerHigh">@color/ice</item>
        <item name="colorSurfaceContainerHighest">@color/blue_mist</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorPrimaryContainer">@color/blue_mist</item>
        <item name="colorOnPrimaryContainer">@color/blue_deep</item>
        <item name="colorSecondaryContainer">@color/blue_mist</item>
        <item name="colorOnSecondaryContainer">@color/blue_deep</item>
        <item name="colorOutline">@color/blue_outline</item>
        <item name="colorOutlineVariant">@color/blue_line</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/stage</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- First-run tips live in their own transparent, full-width window so the
         fullscreen WebView can never claim their button taps. -->
    <style name="Theme.Bluefin.TipsDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.08</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
